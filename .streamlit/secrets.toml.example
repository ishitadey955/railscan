# Copy to .streamlit/secrets.toml (git-ignored) locally, or paste into
# Streamlit Community Cloud: Manage app -> Settings -> Secrets. Never commit the real file.

# PostgreSQL for accounts and history (Supabase: Connect -> Session pooler, port 5432).
# Leave it out to keep accounts in the local SQLite file (data/database/railscan.db).
# The app refuses to start when it is set but does not start with postgresql://
RAILSCAN_ACCOUNTS_DB_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Google Cloud Vision OCR (optional, much better at Hindi/Bengali/Kannada/Telugu signs than EasyOCR).
# Leave it out to read signs with EasyOCR only. Setup: docs/runbooks/deploy.md -> "Google OCR".
# Capped at 1,000 photos a month (Google's free tier); after that the app uses EasyOCR.
GOOGLE_VISION_API_KEY = "<your API key>"

# Gemini OCR (optional, no Google Cloud billing needed): a free key from https://aistudio.google.com
# Used when GOOGLE_VISION_API_KEY is not set or fails. Free tier: Google uses the photos to improve its products.
GEMINI_API_KEY = "<your Gemini API key>"
# GEMINI_OCR_MODEL = "gemini-3.6-flash"    # optional: another Gemini model that reads images
