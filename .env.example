# Environment variables RailScan reads (all optional). Copy to .env for local use; .env is git-ignored.
# On Streamlit Community Cloud use Secrets instead (see .streamlit/secrets.toml.example).

# PostgreSQL for accounts and history. Unset: accounts stay in the local SQLite file.
RAILSCAN_ACCOUNTS_DB_URL=

# Where the railway SQLite database lives (default: data/database/railscan.db).
RAILSCAN_DB_PATH=

# Log level of the JSON logs written to stderr: DEBUG, INFO (default), WARNING, ERROR.
RAILSCAN_LOG_LEVEL=INFO

# Minutes without a scan after which the scanner models (~1 GB) are unloaded (default 10).
RAILSCAN_SCANNER_IDLE_MIN=10

# Google Cloud Vision API key (optional). Unset: signs are read with EasyOCR only.
GOOGLE_VISION_API_KEY=
